# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# Deny every .env variant, then allow back only the two credential-free template
# forms. An allowlist rather than a list of known filenames, because the files
# that leak are the ones nobody thought to name: .env.production.local (Next.js
# reads it), .env.staging, and whatever Vercel CLI writes next. Order matters —
# the negations must stay BELOW the wildcard or they do nothing.
.env*
!.env.example
!.env*.template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Local-only working notes and editor/tooling config (never committed)
docs/PROJECT.md
WARP.md
CLAUDE.md
TODOS.md
.claude/
.cursor/
.windsurf/
.aider*
graphify-out/
