# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.development
.env.test
.env.production
.env.ledger
# Allow template files (no credentials)
!.env*.template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# AI project reference (local only)
docs/PROJECT.md
WARP.md

# AI agent config, instructions, and skills — never publish
.claude/
.claude-*/
CLAUDE.md
**/CLAUDE.md
AGENTS.md
**/AGENTS.md
.cursor/
.cursorrules
.windsurfrules
.aider*
.mcp.json
**/SKILL.md
**/skills/
