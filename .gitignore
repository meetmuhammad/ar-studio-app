# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.development
.env.test
.env.production
.env.ledger
# Allow template files (no credentials)
!.env*.template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# AI project reference (local only)
docs/PROJECT.md
WARP.md

# AI agent config, instructions, and skills — never publish
.claude/
.claude-*/
CLAUDE.md
**/CLAUDE.md
AGENTS.md
**/AGENTS.md
.cursor/
.cursorrules
.windsurfrules
.aider*
.mcp.json
**/SKILL.md
**/skills/

# graphify: commit the graph itself (graph.json / GRAPH_REPORT.md / manifest.json)
# so a clone can query it without a rebuild, but keep the derived and
# regenerable pieces out — graph.html is an 832 KB visualisation and the cache
# and dated backups churn on every single `graphify update .`.
graphify-out/graph.html
graphify-out/GRAPH_TREE.html
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/memory/
graphify-out/reflections/

# local tooling scratch — never part of the app
.gstack/
supabase/.temp/
