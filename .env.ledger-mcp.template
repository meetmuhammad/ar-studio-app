# Ledger MCP server settings. Copy the names you need into the environment of the
# app (Vercel project settings, or .env.local for local testing). Placeholders
# only: never put real values in this file or in Git.

# Off unless exactly "true". While unset, /api/mcp and its discovery document 404.
LEDGER_MCP_ENABLED=false

# The public https origin clients reach the app at. A phone or Claude cannot reach
# http://localhost. Used as the OAuth "resource" and in the 401 challenge.
LEDGER_MCP_PUBLIC_URL=https://<your-app-domain>

# Comma-separated hostnames accepted in Host/Origin headers. Defaults to the host of
# LEDGER_MCP_PUBLIC_URL; add preview hosts here deliberately, never "*".
# LEDGER_MCP_ALLOWED_HOSTS=<your-app-domain>

# OAuth authorization server issuer. Defaults to <NEXT_PUBLIC_SUPABASE_URL>/auth/v1
# LEDGER_MCP_AUTH_SERVER=https://<project-ref>.supabase.co/auth/v1

# "true" refuses ordinary web-session tokens, accepting only tokens issued to a
# connected OAuth client. Turn on once Supabase's OAuth server issues the tokens.
LEDGER_MCP_REQUIRE_OAUTH_CLIENT=false

# How long a prepared entry can be confirmed, in seconds. Default 600.
LEDGER_PROPOSAL_TTL_SECONDS=600

# The IANA timezone that defines "today" for the shop. NO default: the app refuses to
# guess. Asia/Karachi is an assumption (PKR, en-PK) for the owner to confirm.
BUSINESS_TIMEZONE=<IANA timezone, e.g. Asia/Karachi>

# Already used by the rest of the app, listed here because the MCP needs them too.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
