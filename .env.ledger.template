# Supabase Database URL for Ledger Development
# Copy this file to .env.ledger and fill in your dummy database credentials
DATABASE_URL="postgresql://postgres:[YOUR-LEDGER-PASSWORD]@[YOUR-LEDGER-PROJECT].supabase.co:5432/postgres"

# Supabase Configuration for Ledger Development
# Get these values from your Supabase project: Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-LEDGER-PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-LEDGER-ANON-KEY]

SUPABASE_SERVICE_ROLE_KEY=[YOUR-LEDGER-SERVICE-ROLE-KEY]

